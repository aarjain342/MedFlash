# Which LLM backend to use: "gemini" or "ollama"
LLM_PROVIDER=gemini

# --- Gemini (free tier via Google AI Studio: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# --- Ollama (local, no key needed — install from https://ollama.com and run `ollama pull llama3.1`) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Supabase (used to verify user sessions on protected API calls) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

PORT=8787
