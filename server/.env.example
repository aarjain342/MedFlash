# Which LLM backend is primary: "gemini" or "ollama"
LLM_PROVIDER=gemini

# --- Gemini (free tier via Google AI Studio: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# --- Groq (optional — automatic last-resort fallback if every Gemini model is
# rate-limited. Separate vendor, separate quota. Free key: https://console.groq.com/keys ---
GROQ_API_KEY=

# --- Ollama (local, no key needed — install from https://ollama.com and run `ollama pull llama3.1`) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Supabase (used to verify user sessions on protected API calls) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

PORT=8787

# --- Rate limiting (per authenticated user) ---
# Comma-separated emails that bypass limits entirely.
RATE_LIMIT_EXEMPT_EMAILS=
RATE_LIMIT_PER_HOUR=12
RATE_LIMIT_PER_DAY=40

# --- Stripe billing (test mode keys first — see supabase/billing.sql for the schema) ---
# Restricted key (rk_test_...) scoped to: Checkout Sessions, Customers, Billing Portal
# Sessions/Configurations (write), Subscriptions (read), Webhook Endpoints (read).
STRIPE_SECRET_KEY=
# Signing secret (whsec_...) from the webhook endpoint pointed at /api/billing/webhook.
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
# Supabase service role key (Project Settings -> API) — needed for billing writes, which
# happen outside any user's own request (the webhook). Never use this for anything a
# user-scoped request could do instead.
SUPABASE_SERVICE_ROLE_KEY=
# Used to build Checkout/Portal redirect URLs.
FRONTEND_URL=http://localhost:5173
